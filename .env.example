# =============================================================
# Sri Somalamma Talli Temple — environment template
# Copy to .env for local development. NEVER commit .env.
# All values here are server-side only and are never exposed
# to the browser (no VITE_ prefix on any secret).
# =============================================================

# -------------------------------------------------------------
# DATABASE
# -------------------------------------------------------------
# Local development — SQLite, no infrastructure required:
DATABASE_URL=file:./data/temple.db
#
# Production (Aiven PostgreSQL) — replace the whole line with:
# DATABASE_URL=postgres://avnadmin:PASSWORD@your-service.aivencloud.com:PORT/defaultdb?sslmode=require
#
# The driver is chosen automatically from the URL scheme, so no
# code changes are needed when switching.

# PostgreSQL only. Aiven requires SSL; leave unset (or "true") in production.
# DATABASE_SSL=true
# Set to "true" once you supply Aiven's CA certificate.
# DATABASE_REJECT_UNAUTHORIZED=false

# -------------------------------------------------------------
# SESSION SECURITY
# -------------------------------------------------------------
# Minimum 32 characters. Generate a unique value per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-unique-32-character-minimum-random-string

# development | production
APP_ENV=development

# -------------------------------------------------------------
# INITIAL ADMINISTRATOR (used by `npm run seed`)
# -------------------------------------------------------------
# The password is hashed with bcrypt before it is stored; the plain
# value is never written to the database or committed to git.
# Choose a strong password (minimum 10 characters) and change it
# after the first login.
ADMIN_NAME=Temple Administrator
ADMIN_EMAIL=
ADMIN_MOBILE=
ADMIN_PASSWORD=

# -------------------------------------------------------------
# TEMPLE IDENTITY (defaults; editable later in the admin portal)
# -------------------------------------------------------------
TEMPLE_NAME="Sri Somalamma Talli Temple"
TEMPLE_TELUGU_NAME="శ్రీ సోమలమ్మ తల్లి దేవస్థానం"
TEMPLE_LOCATION="P. Gannavaram Mandal, Dr. B. R. Ambedkar Konaseema District, Andhra Pradesh"
